{
  "title": "AIMS Chat API — step-by-step JSON handoff",
  "base_url": "https://aims.igenhr.com",
  "api_prefix": "/api",
  "auth_header": "Authorization: Bearer <access_token>",
  "websocket_chat": "wss://aims.igenhr.com/ws/chat/?token=<access_token>",
  "websocket_p2p": "wss://aims.igenhr.com/ws/p2p/<session_id>/?token=<access_token>",
  "allowed_reaction_emojis": ["👍", "❤️", "😂", "😮", "😢", "🙏", "👏", "🔥"],
  "steps": [
    {
      "step": 1,
      "name": "login_get_jwt",
      "method": "POST",
      "path": "/api/auth/login/",
      "headers": {
        "Content-Type": "application/json"
      },
      "request": {
        "username": "oleee",
        "password": "your_password"
      },
      "response_200_example": {
        "access": "<jwt_access>",
        "refresh": "<jwt_refresh>",
        "access_granted": true,
        "user": {
          "id": 10,
          "username": "oleee"
        }
      },
      "use_next": "Put access into Authorization Bearer for all later steps"
    },
    {
      "step": 2,
      "name": "connect_chat_websocket",
      "type": "websocket",
      "url": "wss://aims.igenhr.com/ws/chat/?token=<access_token>",
      "client_can_send": [
        {
          "type": "typing",
          "receiver_id": 20,
          "is_typing": true
        },
        {
          "type": "group_typing",
          "group_id": 1,
          "is_typing": true
        },
        {
          "type": "mark_read",
          "sender_id": 20
        },
        {
          "type": "group_mark_read",
          "group_id": 1
        },
        {
          "type": "call_invite",
          "call_id": "a1b2c3d4e5f67890",
          "callee_id": 20,
          "call_type": "audio"
        },
        {
          "type": "call_accept",
          "call_id": "a1b2c3d4e5f67890",
          "caller_id": 10
        },
        {
          "type": "call_reject",
          "call_id": "a1b2c3d4e5f67890"
        },
        {
          "type": "call_hangup",
          "call_id": "a1b2c3d4e5f67890"
        },
        {
          "type": "call_dismiss",
          "call_id": "a1b2c3d4e5f67890"
        }
      ],
      "server_can_send_types": [
        "chat_message",
        "group_message",
        "typing_indicator",
        "group_typing",
        "user_status",
        "messages_read",
        "message_reaction",
        "call_invite",
        "call_accept",
        "call_reject",
        "call_hangup",
        "call_dismiss",
        "call_error",
        "notification",
        "error"
      ]
    },
